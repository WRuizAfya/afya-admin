@page "/clientes"

<PageTitle>Clientes | Afya Pedagógico</PageTitle>

<CabecalhoPagina Titulo="Clientes" Subtitulo="Área de Gerenciamento de Clientes.">
	<Acoes>
		<SeletorPeriodo Opcoes="DashboardData.Periodos" @bind-Valor="_classificar" />
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Add">Novo Cliente</MudButton>
	</Acoes>
</CabecalhoPagina>


<MudGrid Spacing="3">
	@foreach (var kpi in DashboardData.Kpis)
	{
		<MudItem xs="12" sm="6" lg="3">
			<KpiCard Kpi="kpi" />
		</MudItem>
	}
	
</MudGrid>

@code {
	private string _classificar = "Ordem Alfabetica (Ascendente)";
}