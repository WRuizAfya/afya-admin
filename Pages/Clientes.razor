@page "/clientes"

<PageTitle>Clientes | Afya Pedagógico</PageTitle>

<CabecalhoPagina Titulo="Clientes" Subtitulo="Área de Gerenciamento de Clientes." @bind-Periodo="_periodo" @bind-Periodo:after="AtualizarDashboard">
	<Acoes>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Add">Novo Cliente</MudButton>
	</Acoes>
</CabecalhoPagina>


<MudGrid Spacing="3">
	@foreach (var kpi in _kpis)
	{
		<MudItem xs="12" sm="6" lg="3">
			<KpiCard Kpi="kpi" />
		</MudItem>
	}
	
</MudGrid>

@code {
	private DashboardDto? _dashboardData;
	private string _periodo = "Últimos 30 dias";
	
	private List<KpiDto> _kpis= new();
	
   protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboardData = await Http.GetFromJsonAsync<DashboardDto>("data/dashboard.json");
            AtualizarDashboard();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar o JSON: {ex.Message}");
        }
	
	}

    private void AtualizarDashboard()
    {
        if (_dashboardData != null && _dashboardData.KpisPorPeriodo.TryGetValue(_periodo, out var kpisEncontrados) )
        {
            _kpis = kpisEncontrados;
        }
    }
}